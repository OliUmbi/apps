# Template for the production .env. Real values live in the ansible vault and
# are rendered to the server as /apps/.env (root:root 600).
# Never commit the filled-in file.

# ---- deploy ----
# tag published by .github/workflows/publish.yml (version tag or sha-<sha>)
IMAGE_TAG=

# ---- dns / certificates ----
# account email for Let's Encrypt
ACME_EMAIL=
# API token with domain:read, dns:read, dns:write scopes
# (caddy DNS-01 + the dyndns timer share this token)
INFOMANIAK_API_TOKEN=

# ---- database ----
POSTGRES_DB=apps
POSTGRES_MIGRATOR_USER=apps_migrator
POSTGRES_MIGRATOR_PASSWORD=
IDENTITY_DATABASE_USER=identity
IDENTITY_DATABASE_PASSWORD=
IDENTITY_INTERNAL_AUTHORIZATION_TOKEN=
MESSAGING_DATABASE_USER=messaging
MESSAGING_DATABASE_PASSWORD=
MESSAGING_INTERNAL_AUTHORIZATION_TOKEN=
ASSETS_DATABASE_USER=assets
ASSETS_DATABASE_PASSWORD=
ASSETS_INTERNAL_AUTHORIZATION_TOKEN=
JUBLAWOMA_DATABASE_USER=jublawoma
JUBLAWOMA_DATABASE_PASSWORD=
UNCLET_DATABASE_USER=unclet
UNCLET_DATABASE_PASSWORD=
ZELGLIHOF_DATABASE_USER=zelglihof
ZELGLIHOF_DATABASE_PASSWORD=
STUDIO_DATABASE_USER=studio
STUDIO_DATABASE_PASSWORD=
DATABASE_POOL_SIZE=10

# ---- monitoring ----
# admin interfaces (grafana, prometheus, alertmanager) bind to this address:
# the server's wireguard IP, so they are only reachable inside the tunnel
MONITORING_BIND=10.8.0.1
GRAFANA_ADMIN_PASSWORD=

# ---- mail ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_TLS=true

# ---- sites ----
JUBLAWOMA_OWNER_EMAIL=
UNCLET_OWNER_EMAIL=
ZELGLIHOF_OWNER_EMAIL=
