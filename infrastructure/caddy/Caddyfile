# Reverse proxy for the apps stack.
#
# Certificates: Let's Encrypt via DNS-01 (Infomaniak API), one wildcard cert
# per domain. Nothing depends on port 80 during issuance and new subdomains
# are covered automatically.
#
# Per-client-IP rate limiting (public traffic and login) and a baseline
# Content-Security-Policy are applied from the shared snippets below; the
# custom image in this directory carries the caddy-ratelimit plugin.
#
# This file is baked into ghcr.io/oliumbi/apps-caddy (infrastructure/caddy),
# so config changes ship as a new image tag like everything else.
{
	email {$ACME_EMAIL}
	acme_dns infomaniak {env.INFOMANIAK_API_TOKEN}
	# Prometheus scrapes the admin endpoint on the private app network. The
	# admin port is never published; only Caddy's 80/443 leave the host.
	# Trust boundary: every container on net-apps can reach this unauthenticated
	# API and rewrite routing. That is accepted for this single-tenant network;
	# a socket or sidecar is the structural fix if the network grows tenants.
	admin :2019
	metrics
}

# Shared behaviour for all sites: compression, the legacy security headers
# (HSTS includeSubDomains is already in the wild, keep it), a baseline CSP and
# caching for static and hashed build files. Body limits live in their own
# snippets because the Studio host needs a larger one.
(common) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Deny powerful features nothing on these sites uses; keep media
		# playback allowed for a future background video (self only).
		Permissions-Policy "accelerometer=(), autoplay=(self), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=(), browsing-topics=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
		defer
	}

	# Vite build outputs carry a content hash in the file name, so a given
	# name never changes and can be cached for a year. This rule must come
	# before the fallback below: that one uses ?Cache-Control and therefore
	# only fills in responses that do not already have the header.
	@hashedAssets path_regexp "^/assets/.+-[A-Za-z0-9_-]{6,}[.](js|css|woff2?)$"
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	# Static files in public/ (pdfs, logos, fonts) are not content hashed and
	# get replaced in place, so no long immutable caching -- only a default
	# for responses where the app set none. Uploaded images under
	# /api/assets/* carry their own Cache-Control + ETag and must win.
	@static path /assets/* /images/* /fonts/*
	header @static ?Cache-Control "public, max-age=3600"
}

# Per-client-IP rate limits. The public zone approximates 10 requests per
# second sustained with a burst of 20 (20 events per 2s window); IPv6 clients
# share a bucket per /64 so cycling addresses does not bypass it. The login
# zone is stricter and must win on its path, so the public zone excludes it.
(ratelimit) {
	rate_limit {
		zone public {
			match {
				not path /api/session/login
			}
			key {remote_host}
			window 2s
			events 20
			ipv4_prefix 0
			ipv6_prefix 64
		}
		zone login {
			match {
				path /api/session/login
			}
			key {remote_host}
			window 1m
			events 10
		}
	}
}

# Request body limits. Public sites keep the legacy nginx limit of 10M;
# Studio accepts its upload maxima (20 MiB images plus 50 MiB PDFs). Caddy
# sizes are decimal (go-humanize), so 50 MiB is 52,428,800 bytes: 55MB leaves
# room for the multipart envelope instead of rejecting a valid PDF.
(public-body) {
	request_body {
		max_size 10MB
	}
}
(studio-body) {
	request_body {
		max_size 55MB
	}
}

# A proxy or app failure gets a short readable body instead of Caddy's empty
# default. Only 5xx is handled: app 404 pages and Caddy's own 429/413 keep
# their normal responses.
(errors) {
	handle_errors {
		@server_error expression {err.status_code} >= 500
		handle @server_error {
			respond "Vorübergehend nicht erreichbar. Bitte später erneut versuchen." {err.status_code}
		}
	}
}

# ---------------------------------------------------------------------------
# jublawoma.ch
# ---------------------------------------------------------------------------
jublawoma.ch, *.jublawoma.ch {
	# admin/studio names converge on studio.oliumbi.ch so sessions survive
	@studio host studio.jublawoma.ch admin.jublawoma.ch
	handle @studio {
		redir https://studio.oliumbi.ch{uri} permanent
	}

	@www host www.jublawoma.ch
	handle @www {
		redir https://jublawoma.ch{uri} permanent
	}

	handle {
		import common
		import ratelimit
		import public-body
		reverse_proxy jublawoma:8001
	}
	import errors
}

