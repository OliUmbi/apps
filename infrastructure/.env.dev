# Template for local development. Copy it to the repository root as `.env`
# (gitignored) and adjust values as needed:
#
#   Copy-Item infrastructure/.env.dev .env
#
# The root `.env` is loaded by the Vite dev servers, by docker compose
# (compose.dev.yaml via `--env-file .env`) and by IDE run configurations.
# Never reuse these values in a deployed environment.

DATABASE_URL=postgresql://localhost:5432/apps
POSTGRES_DB=apps

POSTGRES_MIGRATOR_USER=apps_migrator
POSTGRES_MIGRATOR_PASSWORD=dev-migrator-password

IDENTITY_DATABASE_USER=identity
IDENTITY_DATABASE_PASSWORD=identity_password
IDENTITY_INTERNAL_AUTHORIZATION_TOKEN=dev_identity_internal_authorization

MESSAGING_DATABASE_USER=messaging
MESSAGING_DATABASE_PASSWORD=messaging_password
MESSAGING_INTERNAL_AUTHORIZATION_TOKEN=dev_messaging_internal_authorization

ASSETS_DATABASE_USER=assets
ASSETS_DATABASE_PASSWORD=assets_password
ASSETS_INTERNAL_AUTHORIZATION_TOKEN=dev_assets_internal_authorization

STUDIO_DATABASE_USER=studio
STUDIO_DATABASE_PASSWORD=studio_password

OLIUMBI_DATABASE_USER=oliumbi
OLIUMBI_DATABASE_PASSWORD=oliumbi_password

JUBLAWOMA_DATABASE_USER=jublawoma
JUBLAWOMA_DATABASE_PASSWORD=jublawoma_password

UNCLET_DATABASE_USER=unclet
UNCLET_DATABASE_PASSWORD=unclet_password

ZELGLIHOF_DATABASE_USER=zelglihof
ZELGLIHOF_DATABASE_PASSWORD=zelglihof_password

DATABASE_POOL_SIZE=10

MESSAGING_SMTP_HOST=localhost
MESSAGING_SMTP_CONTAINER_HOST=mailpit
MESSAGING_SMTP_PORT=1025
MESSAGING_SMTP_USERNAME=
MESSAGING_SMTP_PASSWORD=
MESSAGING_SMTP_AUTH=false
MESSAGING_SMTP_TLS=false

ZELGLIHOF_PUBLIC_URL=http://localhost:8003
ZELGLIHOF_REQUESTS_EMAIL=hof@zelglihof.ch
ZELGLIHOF_NEWSLETTER_EMAIL=newsletter@zelglihof.ch
UNCLET_REQUESTS_EMAIL=info@uncle-t.ch
IDENTITY_SERVICE_URL=http://localhost:8081
MESSAGING_SERVICE_URL=http://localhost:8082
STUDIO_SECURE_COOKIES=false

ASSETS_SERVICE_URL=http://localhost:8083
VITE_ASSETS_PUBLIC_URL=http://localhost:8083
ASSETS_PUBLIC_URL=http://localhost:8083
