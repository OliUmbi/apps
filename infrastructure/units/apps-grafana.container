# Grafana. Datasources and dashboards are provisioned from the bind mount, so
# the repository is the source of truth and UI edits are refused; the
# data-grafana volume holds users and history only (not backed up, see the
# volume note).
[Unit]
Description=Grafana
# It publishes on the WireGuard address; wait for the tunnel so a plain reboot
# cannot race the bind (DR-16).
Wants=wg-quick@wg0.service
After=wg-quick@wg0.service

[Container]
Image=docker.io/grafana/grafana:13.3.0@sha256:488984b716c0862639f91a698adbe2862677a5a07bad42da5f03f3030883b205
ContainerName=grafana
Network=net-monitoring.network
EnvironmentFile=/etc/default/apps-grafana
Environment=GF_USERS_ALLOW_SIGN_UP=false
Volume=/apps/monitoring/grafana/provisioning:/etc/grafana/provisioning:ro
Volume=data-grafana.volume:/var/lib/grafana
PublishPort={{ monitoring_bind }}:3000:3000
Pull=missing
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
