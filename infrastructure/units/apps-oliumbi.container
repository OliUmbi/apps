# Oliumbi placeholder site (Nitro, :8004). It writes only the shared anonymous
# analytics counter; its content schema stays empty and it needs no service
# dependency. Caddy routes oliumbi.ch here.
[Unit]
Description=Oliumbi site

[Container]
Image=ghcr.io/oliumbi/apps-oliumbi:{{ image_tag }}
ContainerName=oliumbi
Network=net-apps.network
EnvironmentFile=/etc/default/apps-oliumbi
HealthCmd=wget -q --spider http://127.0.0.1:8004/
HealthInterval=15s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=30s
# The image already runs as its own unprivileged user; no capabilities
# are needed (see infrastructure/units/README.md).
DropCapability=ALL
NoNewPrivileges=true
Pull=missing
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
