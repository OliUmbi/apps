# Studio (shared administration app, Nitro SSR, :8000). Talks to all three
# services; their URLs are static, the internal tokens come from the
# environment file.
[Unit]
Description=Studio
Requires=apps-migrate.service
Wants=apps-identity.service apps-messaging.service apps-assets.service
After=apps-migrate.service apps-identity.service apps-messaging.service apps-assets.service

[Container]
Image=ghcr.io/oliumbi/apps-studio:{{ image_tag }}
ContainerName=studio
Network=net-apps.network
EnvironmentFile=/etc/default/apps-studio
Environment=DATABASE_POOL_SIZE=10
Environment=STUDIO_SECURE_COOKIES=true
Environment=ASSETS_SERVICE_URL=http://assets:8083
Environment=MESSAGING_SERVICE_URL=http://messaging:8082
Environment=IDENTITY_SERVICE_URL=http://identity:8081
Environment=ZELGLIHOF_PUBLIC_URL=https://zelglihof-maegenwil.ch
HealthCmd=wget -q --spider http://127.0.0.1:8000/
HealthInterval=15s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=30s
# The image already runs as its own unprivileged user; no capabilities
# are needed (see infrastructure/units/README.md).
DropCapability=ALL
NoNewPrivileges=true
Pull=missing
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
