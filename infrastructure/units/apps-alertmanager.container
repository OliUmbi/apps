# Alertmanager. The ntfy receiver URL is injected into the bind-mounted config
# by the ansible app role.
[Unit]
Description=Alertmanager
# It publishes on the WireGuard address; wait for the tunnel so a plain reboot
# cannot race the bind (DR-16).
Wants=wg-quick@wg0.service
After=wg-quick@wg0.service

[Container]
Image=docker.io/prom/alertmanager:v0.35.0@sha256:e638797febd034838eca8b98cdbd46f951e9bf7f178777aa8669167406a9946c
ContainerName=alertmanager
Network=net-monitoring.network
Volume=/apps/monitoring/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
PublishPort={{ monitoring_bind }}:9093:9093
Pull=missing
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
