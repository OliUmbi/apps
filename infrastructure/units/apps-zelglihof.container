# Zelglihof site (Nitro SSR, :8003). See apps-jublawoma.container.
[Unit]
Description=Zelglihof site
Requires=apps-migrate.service
Wants=apps-assets.service apps-messaging.service
After=apps-migrate.service apps-assets.service apps-messaging.service

[Container]
Image=ghcr.io/oliumbi/apps-zelglihof:{{ image_tag }}
ContainerName=zelglihof
Network=apps.network
EnvironmentFile=/etc/default/apps-zelglihof
Environment=DATABASE_POOL_SIZE=10
Environment=ASSETS_SERVICE_URL=http://assets:8083
Environment=MESSAGING_SERVICE_URL=http://messaging:8082
Environment=ZELGLIHOF_PUBLIC_URL=https://zelglihof-maegenwil.ch
HealthCmd=wget -q --spider http://127.0.0.1:8003/
HealthInterval=15s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=30s
Pull=missing
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
