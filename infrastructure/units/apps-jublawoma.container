# Jublawoma site (Nitro SSR, :8001). Static wiring lives here; secrets and
# per-environment values come from the environment file.
[Unit]
Description=Jublawoma site
Requires=apps-migrate.service
Wants=apps-assets.service apps-messaging.service
After=apps-migrate.service apps-assets.service apps-messaging.service

[Container]
Image=ghcr.io/oliumbi/apps-jublawoma:{{ image_tag }}
ContainerName=jublawoma
Network=net-apps.network
EnvironmentFile=/etc/default/apps-jublawoma
Environment=DATABASE_POOL_SIZE=10
Environment=ASSETS_SERVICE_URL=http://assets:8083
Environment=MESSAGING_SERVICE_URL=http://messaging:8082
Environment=JUBLAWOMA_PUBLIC_URL=https://jublawoma.ch
HealthCmd=wget -q --spider http://127.0.0.1:8001/
HealthInterval=15s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=30s
# The image already runs as its own unprivileged user; no capabilities
# are needed (see infrastructure/units/README.md).
DropCapability=ALL
NoNewPrivileges=true
Pull=missing
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
