# PostgreSQL 18. The data directory is a plain host directory so the backup
# script can dump and tar it without container tricks. The image entrypoint
# chowns the directory (uid 70) on first start.
[Unit]
Description=PostgreSQL 18 (apps)

[Container]
Image=docker.io/library/postgres:18-alpine@sha256:9ba53c7d41ea093baf5c1ba635ba5434c4f979880527d49bb7d9237d3193085b
ContainerName=postgres
Network=net-apps.network
EnvironmentFile=/etc/default/apps-postgres
Volume=/var/lib/apps/postgres:/var/lib/postgresql
# Without -U, pg_isready connects as the container's OS user (root), which the
# server logs as FATAL: role "root" does not exist on every probe. These mirror
# POSTGRES_USER/POSTGRES_DB in /etc/default/apps-postgres; the cluster's only
# superuser is the migrator role, there is no "postgres" role.
HealthCmd=pg_isready -U apps_migrator -d apps
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=30s
Pull=missing
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
