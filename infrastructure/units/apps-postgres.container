# PostgreSQL 18. The data directory is a plain host directory so the backup
# script can dump and tar it without container tricks. The image entrypoint
# chowns the directory (uid 70) on first start.
[Unit]
Description=PostgreSQL 18 (apps)

[Container]
Image=docker.io/library/postgres:18-alpine@sha256:9ba53c7d41ea093baf5c1ba635ba5434c4f979880527d49bb7d9237d3193085b
ContainerName=postgres
Network=net-apps.network
EnvironmentFile=/etc/default/apps-postgres
Volume=/var/lib/apps/postgres:/var/lib/postgresql
HealthCmd=pg_isready
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=30s
Pull=missing
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
