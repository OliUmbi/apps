# PostgreSQL statistics exporter. Read-only: it connects as the `monitoring`
# role (pg_monitor) and exposes connection, lock, database-size and transaction
# counters to Prometheus on the private monitoring network.
[Unit]
Description=PostgreSQL exporter (apps)
Wants=apps-postgres.service
After=apps-postgres.service

[Container]
Image=quay.io/prometheuscommunity/postgres-exporter:v0.19.0@sha256:e8a170b85eab07c75c2b0f3aa2806be5c2fe5bba46fd0336914e1f36572cde08
ContainerName=postgres-exporter
# net-apps reaches postgres; net-monitoring is where Prometheus scrapes it.
Network=net-apps.network
Network=net-monitoring.network
EnvironmentFile=/etc/default/apps-postgres-exporter
Pull=missing
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
