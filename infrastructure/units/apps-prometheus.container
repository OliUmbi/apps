# Prometheus. Joins both networks: monitoring for its peers, apps to probe the
# app containers directly (see infrastructure/monitoring/prometheus.yml).
[Unit]
Description=Prometheus
# It publishes on the WireGuard address; wait for the tunnel so a plain reboot
# cannot race the bind (DR-16).
Wants=wg-quick@wg0.service
After=wg-quick@wg0.service

[Container]
Image=docker.io/prom/prometheus:v3.16.0@sha256:e04987641b57704f408e31f6373ba4138ecf27cb4a165d24aabb6c38fddd0f06
ContainerName=prometheus
Network=net-apps.network
Network=net-monitoring.network
Exec=--config.file=/etc/prometheus/prometheus.yml --storage.tsdb.retention.size=2GB
Volume=/apps/monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro
Volume=/apps/monitoring/alerts.yml:/etc/prometheus/alerts.yml:ro
Volume=data-prometheus.volume:/prometheus
PublishPort={{ monitoring_bind }}:9090:9090
Pull=missing
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
