              {
                "color": "yellow",
                "value": 7
              },
              {
                "color": "green",
                "value": 14
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
