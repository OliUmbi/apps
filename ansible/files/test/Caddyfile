# TEST-ONLY Caddyfile for the disposable feedback host.
#
# Differences from infrastructure/caddy/Caddyfile:
# - No Infomaniak DNS-01/ACME config. Hostnames are sslip.io names that
#   resolve to the public IP, so Caddy issues normal Let's Encrypt certs via
#   HTTP-01/TLS-ALPN. This is why TCP 80 and 443 must be reachable.
# - One host per site instead of apex/www/studio redirects.
#
# It is mounted over /etc/caddy/Caddyfile by ansible/playbooks/test-host.yml.
# Do not use this file in a deployed environment.

{
	email acme@oliumbi.ch
	admin :2019
	metrics
}

(common) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), autoplay=(self), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=(), browsing-topics=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
		defer
	}

	@hashedAssets path_regexp "^/assets/.+-[A-Za-z0-9_-]{6,}[.](js|css|woff2?)$"
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	@static path /assets/* /images/* /fonts/*
	header @static ?Cache-Control "public, max-age=3600"
}

(ratelimit) {
	rate_limit {
		zone public {
			match {
				not path /api/session/login
			}
			key {remote_host}
			window 2s
			events 20
			ipv4_prefix 0
			ipv6_prefix 64
		}
		zone login {
			match {
				path /api/session/login
			}
			key {remote_host}
			window 1m
			events 10
		}
	}
}

(public-body) {
	request_body {
		max_size 10MB
	}
}
(studio-body) {
	request_body {
		max_size 55MB
	}
}

(errors) {
	handle_errors {
		@server_error expression {err.status_code} >= 500
		handle @server_error {
			respond "Vorübergehend nicht erreichbar. Bitte später erneut versuchen." {err.status_code}
		}
	}
}

jublawoma.86-119-66-183.sslip.io {
	import common
	import ratelimit
	import public-body
	reverse_proxy jublawoma:8001
	import errors
}

unclet.86-119-66-183.sslip.io {
	import common
	import ratelimit
	import public-body
	reverse_proxy unclet:8002
	import errors
}

zelglihof.86-119-66-183.sslip.io {
	import common
	import ratelimit
	import public-body
	reverse_proxy zelglihof:8003
	import errors
}

oliumbi.86-119-66-183.sslip.io {
	import common
	import ratelimit
	import public-body
	reverse_proxy oliumbi:8004
	import errors
}

studio.86-119-66-183.sslip.io {
	import common
	import ratelimit
	import studio-body
	reverse_proxy studio:8000
	import errors
}
