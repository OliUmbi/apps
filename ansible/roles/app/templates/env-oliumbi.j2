# rendered by ansible from group_vars/vault.yml -- do not edit on the server
# Quadlet passes this file to `podman run --env-file`, which keeps values
# literally: do not quote them (quotes would become part of the secret).
# The database role is fixed in the app; DATABASE_URL stays free of credentials
# and the password is supplied separately (DR-11).
DATABASE_URL=postgresql://postgres:5432/{{ vault_postgres_db }}
OLIUMBI_DATABASE_PASSWORD={{ vault_oliumbi_database_password }}
