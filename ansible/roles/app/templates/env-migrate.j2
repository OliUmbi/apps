# rendered by ansible from group_vars/vault.yml -- do not edit on the server
# Quadlet passes this file to `podman run --env-file`, which keeps values
# literally: do not quote them (quotes would become part of the secret).
# flyway reads FLYWAY_* in place of the CLI flags
FLYWAY_URL=jdbc:postgresql://postgres:5432/{{ vault_postgres_db }}
FLYWAY_USER={{ vault_postgres_migrator_user }}
FLYWAY_PASSWORD={{ vault_postgres_migrator_password }}
FLYWAY_LOCATIONS=filesystem:/flyway/sql
FLYWAY_CONNECT_RETRIES=60
