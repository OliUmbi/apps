{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/src/**/*",
      "**/index.html",
      "**/vite.config.ts",
      "**/vite.config.js",
      "**/vite.ts",
      "**/package.json",
      "**/tsconfig.json",
      "biome.json",
      "packages/i18n/config.mjs",
      "packages/i18n/generate.mjs",
      "packages/i18n/lock.mjs",
      "tests/**/*.ts",
      "!**/src/routeTree.gen.ts",
      "!**/src/paraglide",
      "!**/.dependencies-before-rework",
      "!**/node_modules",
      "!**/.output",
      "!**/dist",
      "!**/.tanstack"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noArrayIndexKey": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
