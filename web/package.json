{
  "name": "web",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm --workspace-concurrency=1 --filter \"./sites/*\" -r build",
    "build:jublawoma": "pnpm --filter jublawoma build",
    "build:oliumbi": "pnpm --filter oliumbi build",
    "build:studio": "pnpm --filter studio build",
    "build:unclet": "pnpm --filter unclet build",
    "build:zelglihof": "pnpm --filter zelglihof build",
    "check": "biome check",
    "dev:jublawoma": "pnpm --filter jublawoma dev",
    "dev:oliumbi": "pnpm --filter oliumbi dev",
    "dev:studio": "pnpm --filter studio dev",
    "dev:unclet": "pnpm --filter unclet dev",
    "dev:zelglihof": "pnpm --filter zelglihof dev",
    "fix": "biome check --write",
    "generate": "pnpm --filter @oliumbi/i18n generate",
    "test": "node --env-file-if-exists=../.env --import tsx --test tests/*.test.ts tests/integration/*.test.ts",
    "typecheck": "pnpm generate && pnpm -r check && tsc --project tests/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "drizzle-orm": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
